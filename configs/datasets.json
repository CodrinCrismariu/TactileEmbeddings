    "code_cache": "processing/sensor_code_cache_storage_v1",
    "marker_targets": "processing/marker_displacement_storage_v1/targets",
    "expansion_ready": "processing/data_expansion_v1/ready.json",
    "acquisition_ready": "processing/joint_acquisitions_mirrored_v2/ready.json",
    "acquisition_root": "processing/data_queue_v2",
    "archived_producers": "legacy/v1/src/tactilelatent"
