{
  "dataset_family": "joint_all",
  "manifest": "processing/joint_all/manifest.json",
  "output": "processing/runs/joint_all_holdout_vla_vae32",
  "init_checkpoint": "processing/runs/egotouch_dinov3_vae_image_only_latent32/last.pt",
  "heldout_source": "ftp_vla_touch",
  "seed": 45,
  "epochs": 20,
  "batch_size": 2,
  "accumulation": 16,
  "workers": 4,
  "train_windows_per_source_per_epoch": 512,
  "validation_windows_per_source": 64,
  "learning_rate": 0.00005,
  "min_learning_rate": 0.000001,
  "weight_decay": 0.05,
  "warmup_epochs": 2,
  "width": 768,
  "heads": 8,
  "temporal_layers": 3,
  "cross_view_layers": 2,
  "latent_dim": 32,
  "latent_objective": "vae",
  "dropout": 0.1,
  "stochastic": true,
  "beta_max": 0.001,
  "beta_warmup_epochs": 10,
  "wrist_dropout": 0.3,
  "log_every": 10
}
