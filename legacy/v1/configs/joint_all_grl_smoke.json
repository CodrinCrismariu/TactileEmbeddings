  "dropout": 0.1,
  "stochastic": true,
  "beta_max": 0.001,
  "beta_warmup_epochs": 10,
  "wrist_dropout": 0.3,
  "diagnostic_epochs": [2],
  "diagnostic_fit_clips": 2,
  "diagnostic_score_clips": 2,
  "diagnostic_probe_epochs": 1,
  "diagnostic_samples": 2,
  "diagnostic_threshold": 0.14,
  "grl_max": 2.0,
  "snapshot_epochs": [2],
  "log_every": 1
