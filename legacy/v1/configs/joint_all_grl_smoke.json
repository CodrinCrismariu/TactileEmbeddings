{
  "dataset_family": "joint_all",
  "manifest": "processing/joint_all/manifest.json",
  "output": "processing/runs/joint_all_grl_smoke_calibration",
  "init_checkpoint": null,
  "init_joint_checkpoint": null,
  "heldout_source": "ftp_vla_touch",
  "seed": 45,
  "epochs": 2,
  "batch_size": 2,
