{
  "model_type": "joint_sensor_alignment_v1",
  "dataset_family": "joint_all",
  "latent_objective": "vae",
  "manifest": "processing/joint_alignment/manifest.json",
  "audit": "processing/joint_alignment/audit.json",
  "teachers": "processing/joint_alignment/teachers.json",
  "code_cache": "processing/sensor_code_cache_v1",
  "output": "processing/runs/joint_alignment_holdout_motiontrans",
  "heldout_source": "ftp_motiontrans",
  "init_checkpoint": null,
  "init_joint_checkpoint": null,
  "seed": 45,
  "epochs": 200,
  "batch_size": 2,
  "accumulation": 16,
  "workers": 4,
  "train_windows_per_source_per_epoch": 8000,
  "validation_windows_per_source": 64,
  "learning_rate": 5e-05,
  "min_learning_rate": 1e-06,
  "weight_decay": 0.05,
  "warmup_epochs": 2,
  "width": 768,
  "heads": 8,
  "temporal_layers": 3,
  "cross_view_layers": 2,
  "latent_dim": 32,
  "adapter_hidden_dims": [
    128,
    128
  ],
  "dropout": 0.1,
  "stochastic": true,
  "beta_max": 0.001,
  "beta_warmup_epochs": 10,
  "wrist_dropout": 0.3,
  "optimizer_method": "sam_adamw",
  "sam_rho": 0.05,
  "log_every": 100,
  "checkpoint_every": 10,
  "save_viewer_epochs": true
}
