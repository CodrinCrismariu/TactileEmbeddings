  "egotouch": "Reuse preserved v4 and initial grid checkpoints",
  "description": "Four decoder candidates for each of eight image/pressure/glove datasets. Scalar force, bilateral force and six-channel torque excluded from autoencoder pretraining by user request.",
  "selection_rationale": {
    "egotouch_evidence": "Matched first60-epoch sigmoid comparisons favor width and larger codes for detailed pressure outputs: wide64/code256 MAE .006845; same width/code128 .008249; code64 .012311; deep/code256 .012190. This guides image capacity, not scalar sensor code size.",
    "numeric_outputs": "Scalar force, bilateral force and six torque channels use direct prediction heads in future joint training and are excluded from this autoencoder plan.",
    "pressure_vectors": "Use code8/16 for 160 OpenGraph taxels, and code16/32 for 256 EgoTactile taxels or 16x16 OpenTouch grids. No physical grid is invented for stored-index vectors.",
    "optical_outputs": "Medium/large five-stage convolutional networks, code128/256, native pixels unchanged.",
    "preservation": "All old checkpoints stay available; only the four configured candidates participate in promotion. Data splits, preprocessing, per-trial optimization, 30/100 epochs and seed repetitions remain unchanged."
  },
  "excluded_autoencoder_sources": {
    "ftp_motiontrans": "Direct numeric prediction; no sensor reconstruction autoencoder.",
    "ftp_rdp": "Direct numeric prediction; no sensor reconstruction autoencoder.",
    "ftp_rdp_bimanual": "Direct numeric prediction; no sensor reconstruction autoencoder."
  }
