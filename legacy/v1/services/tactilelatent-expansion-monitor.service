[Unit]
Description=TactileLatent earlier dataset progress monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/codrincrismariu/Documents/TactileLatent
ExecStart=/home/codrincrismariu/Documents/TactileLatent/.venv/bin/python -u scripts/monitor_data_expansion.py
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=1
Restart=on-failure
RestartSec=30
Nice=15

[Install]
WantedBy=default.target
