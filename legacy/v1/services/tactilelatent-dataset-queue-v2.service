[Unit]
Description=TactileLatent download and processing queue
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/codrincrismariu/Documents/TactileLatent
ExecStart=/home/codrincrismariu/Documents/TactileLatent/.venv/bin/python -u scripts/run_dataset_queue.py run
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=1
Restart=on-failure
RestartSec=30
Nice=15

[Install]
WantedBy=default.target
